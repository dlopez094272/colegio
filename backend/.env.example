# =====================================================
# Gestión Escolar — Plantilla de configuración
# Copiar este archivo a .env y completar con los valores reales.
# NUNCA subir .env al repositorio.
# =====================================================

# Server
PORT=3100
NODE_ENV=production
TZ=America/Guatemala

# Base de datos: NO va aquí. Las credenciales de cada cliente van en tenants.json.

JWT_EXPIRES_IN=12h

# SMTP para envío de correos
SMTP_HOST=mail.tudominio.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notificaciones@tudominio.com
SMTP_PASS=CONTRASEÑA_SMTP
SMTP_FROM="Gestión Escolar <notificaciones@tudominio.com>"

# CORS: incluir TODOS los subdominios de clientes
CORS_ORIGINS=https://colegio1.tudominio.com
